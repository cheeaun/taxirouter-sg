{
  "name": "taxirouter-sg",
  "version": "4.0.0",
  "description": "Explore available taxis and taxi stands in Singapore",
  "keywords": [
    "taxi",
    "singapore",
    "transport"
  ],
  "author": "Lim Chee Aun",
  "license": "MIT",
  "scripts": {
    "start": "parcel serve --no-hmr ./src/index.html",
    "start-https": "npm start -- --https",
    "build": "parcel build ./src/index.html",
    "postbuild": "cpy public/* dist",
    "taxi-stands": "node scripts/fetch-taxi-stands.js"
  },
  "dependencies": {
    "@turf/circle": "~7.4.0",
    "@turf/helpers": "~7.4.0",
    "@turf/nearest-point": "~7.4.0",
    "@turf/points-within-polygon": "~7.4.0",
    "mapbox-gl": "~3.34.2"
  },
  "devDependencies": {
    "cpy-cli": "~7.0.0",
    "parcel": "~3.0.0-0"
  }
}
